{
  "info": {
    "name": "ShopSmart API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "End-to-end API collection for ShopSmart Express + TypeScript + PostgreSQL"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "cartId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Prometheus Metrics",
      "request": { "method": "GET", "url": "{{baseUrl}}/metrics" }
    },
    {
      "name": "Register Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\"\n}"
        }
      }
    },
    {
      "name": "Login Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\"\n}"
        }
      }
    },
    {
      "name": "List Products",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products" }
    },
    {
      "name": "Create Cart",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/cart" }
    },
    {
      "name": "Add Item to Cart",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/cart/{{cartId}}/items",
        "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}" }
      }
    },
    {
      "name": "Apply Coupon SAVE10",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/cart/{{cartId}}/coupon",
        "body": { "mode": "raw", "raw": "{\n  \"code\": \"SAVE10\"\n}" }
      }
    },
    {
      "name": "Checkout Cart",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/cart/{{cartId}}/checkout",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@example.com\",\n  \"card_token\": \"tok_ok\"\n}"
        }
      }
    },
    {
      "name": "Lookup Order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}?email=customer@example.com"
      }
    },
    {
      "name": "Chat Support",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/chat",
        "body": { "mode": "raw", "raw": "{\n  \"message\": \"How long does shipping take?\"\n}" }
      }
    }
  ]
}
