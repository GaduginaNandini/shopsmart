{
  "name": "shopsmart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --format=esm --platform=browser --outfile=public/assets/app.js",
    "dev": "npm run build:client && tsx server.ts",
    "build": "npm run build:client && tsc --noEmit",
    "start": "node server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "pg": "^8.23.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
