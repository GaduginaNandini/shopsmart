{
  "title": "ShopSmart Operations Dashboard",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Application Availability",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"shopsmart\"}", "legendFormat": "Target Up", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Total HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "shopsmart_requests_total", "legendFormat": "Requests", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "HTTP Error Rate (5xx / Total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "rate(shopsmart_errors_total[5m]) / clamp_min(rate(shopsmart_requests_total[5m]), 1)", "legendFormat": "Error Rate", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Total 5xx Errors",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "shopsmart_errors_total", "legendFormat": "5xx Errors", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "HTTP Request Duration (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "shopsmart_response_seconds_avg", "legendFormat": "Cumulative Avg (s)", "refId": "A" },
        { "expr": "rate(shopsmart_response_seconds_sum[5m]) / clamp_min(rate(shopsmart_requests_total[5m]), 1)", "legendFormat": "5m Avg Duration (s)", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Request Rate & Checkout Outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "rate(shopsmart_requests_total[1m])", "legendFormat": "Requests/sec", "refId": "A" },
        { "expr": "shopsmart_orders_ok_total", "legendFormat": "Orders OK", "refId": "B" },
        { "expr": "shopsmart_orders_failed_total", "legendFormat": "Orders Failed", "refId": "C" }
      ]
    }
  ]
}
