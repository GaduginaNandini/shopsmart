{
 "title": "ShopSmart Health",
 "uid": "shopsmart",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Requests / s",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "rate(shopsmart_requests_total[1m])",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "title": "Avg response time (s)",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "shopsmart_response_seconds_avg",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "title": "Orders OK",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "shopsmart_orders_ok_total",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "title": "Orders failed",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "shopsmart_orders_failed_total",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "title": "5xx errors",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "shopsmart_errors_total",
     "refId": "A"
    }
   ]
  }
 ]
}