@startuml
!pragma layout smetana
left to right direction
skinparam shadowing false
actor Customer
actor "Shop Owner" as Owner
actor "Support Agent" as Agent
rectangle ShopSmart {
  usecase "Browse catalogue" as UC1
  usecase "Manage cart" as UC2
  usecase "Apply coupon" as UC3
  usecase "Checkout (mock payment)" as UC4
  usecase "Ask chatbot (order / policy)" as UC5
  usecase "Manage products and stock" as UC6
  usecase "View orders" as UC7
  usecase "Handle escalated question" as UC8
}
Customer --> UC1
Customer --> UC2
Customer --> UC4
Customer --> UC5
UC2 ..> UC3 : <<extend>>
Owner --> UC6
Owner --> UC7
Agent --> UC8
UC5 ..> UC8 : <<extend>>\nwhen not in policy
@enduml
