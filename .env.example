# Server configuration
PORT=3000

# Optional Gemini API key for chatbot LLM responses (falls back to offline policy retrieval if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Owner authentication token for POST /api/products
OWNER_TOKEN=owner-dev-token

# Original database connection string (mocked in-memory in this environment)
DATABASE_URL=
